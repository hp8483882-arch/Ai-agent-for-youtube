# Bu faylni ".env" nomi bilan nusxalab, o'z kalitlaringizni yozing.
# GitHub'da esa bularni "Settings > Secrets and variables > Actions" ga qo'shasiz.

# --- Skript yozish uchun LLM (bittasi kifoya) ---
GROQ_API_KEY=            # bepul: https://console.groq.com
ANTHROPIC_API_KEY=       # sifatliroq, arzon: https://console.anthropic.com

# --- Ovoz (TTS) ---
AISHA_API_KEY=           # https://aisha.group (o'zbek tiliga ixtisoslashgan)

# --- YouTube yuklash uchun ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=        # get_youtube_token.py orqali bir marta olinadi

# --- Sozlamalar ---
CHANNEL_NICHE="Bolalar uchun qiziqarli va ta'limiy AI multfilm hikoyalar"
